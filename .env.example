# Copy to .env.local (git-ignored) and change what you need. Next.js and the bun scripts
# (`bun run infra:up`, `db:*`, `test:integration`) load it. Every value below is the default,
# so a fresh clone works without a .env.local. See docs/POSTGRES.md.

# --- Docker Compose (docker-compose.yml) ---------------------------------------------------
# Parallel worktrees: give each its own project name and host ports so they don't collide.
COMPOSE_PROJECT_NAME=crate-designer
DB_PORT=5432
DB_NAME=crate_designer
BLOB_PORT=9000
BLOB_CONSOLE_PORT=9001

# --- Postgres -----------------------------------------------------------------------------------
# Built from DB_PORT and DB_NAME when unset (postgres://crate:crate@localhost:$DB_PORT/$DB_NAME).
# Set it to use another server (a hosted Postgres, CI); it then wins over DB_PORT / DB_NAME.
# DATABASE_URL=postgres://crate:crate@localhost:5432/crate_designer
# Connections in the app's pool.
# DB_POOL_MAX=10

# --- Blob storage (S3 API; the compose emulator by default) -------------------------------------
# Server-only: never expose these to the browser (no NEXT_PUBLIC_ prefix).
# Follows BLOB_PORT: change both together.
BLOB_ENDPOINT=http://localhost:9000
BLOB_REGION=us-east-1
BLOB_BUCKET=crate-designer-dev
BLOB_ACCESS_KEY_ID=crate-dev
BLOB_SECRET_ACCESS_KEY=crate-dev-secret
BLOB_FORCE_PATH_STYLE=true
# Endpoint written into presigned URLs, if the browser reaches the store by another host than the
# server (defaults to BLOB_ENDPOINT). For AWS S3, R2 or GCS see docs/BLOB_STORAGE.md.
# BLOB_PUBLIC_ENDPOINT=http://localhost:9000
