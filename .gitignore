# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Session exports saved into the repo root (root-anchored, so no project file is hidden)
/SESSION *.txt
/2026-*.txt
