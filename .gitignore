# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright (#34)
/e2e/screenshots/
/test-results/
/playwright-report/
/blob-report/
