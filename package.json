{
  "name": "crate-designer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run infra:up && bun run db:migrate && bun run engine:build && next dev",
    "dev:app": "next dev",
    "build": "bun run engine:build && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "e2e": "playwright test",
    "e2e:docs-shots": "node scripts/docs-shots.mjs",
    "e2e:ui": "playwright test --ui",
    "infra:up": "bun scripts/infra.ts up",
    "infra:down": "bun scripts/infra.ts down",
    "db:up": "bun run infra:up",
    "db:down": "bun run infra:down",
    "db:migrate": "bun scripts/infra.ts migrate",
    "db:reset": "bun scripts/infra.ts reset",
    "db:psql": "bun scripts/infra.ts psql",
    "db:generate": "drizzle-kit generate",
    "blob:gc": "bun scripts/blob-gc.ts",
    "engine:build": "bun build src/server/workers/engineThread.ts --target=node --format=esm --outfile=.engine-worker/engine-thread.mjs",
    "worker": "bun run engine:build && bun scripts/worker.ts",
    "apikey:create": "bun scripts/apikey.ts create",
    "apikey:list": "bun scripts/apikey.ts list",
    "apikey:revoke": "bun scripts/apikey.ts revoke",
    "crate": "bun src/cli/crate.ts",
    "load": "node scripts/load/run.mjs",
    "load:lock": "bun scripts/load/lock.ts",
    "preinstall": "node scripts/require-bun.mjs",
    "prepare": "simple-git-hooks",
    "format": "prettier --write .",
    "fixtures": "bun scripts/fixtures/scenarios.mjs",
    "format:check": "prettier --check .",
    "knip": "knip"
  },
  "simple-git-hooks": {
    "pre-commit": "if [ -f scripts/pre-commit.mjs ]; then exec bun scripts/pre-commit.mjs; fi"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "jspdf": "4.2.1",
    "next": "16.4.6",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "three": "0.187.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "6.2.8",
    "jsdom": "30.1.3",
    "knip": "6.45.1",
    "prettier": "3.10.1",
    "simple-git-hooks": "2.14.0",
    "tailwindcss": "4.3.3",
    "three-stdlib": "2.36.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "packageManager": "bun@1.3.5"
}
