{
  "name": "crate-designer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "preinstall": "node scripts/require-bun.mjs",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "if [ -f scripts/pre-commit.mjs ]; then exec bun scripts/pre-commit.mjs; fi"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.187.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "simple-git-hooks": "2.14.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "packageManager": "bun@1.3.5"
}
